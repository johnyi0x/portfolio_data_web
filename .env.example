# PnL Neon (default board). Pooled URI preferred on Vercel (-pooler).
BAGINDEX_DATABASE_URL_PNL=postgresql://USER:PASSWORD@ep-pnl-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or: DATABASE_URL_PNL=...

# ROI Neon (toggle). Legacy single URL also counts as ROI.
BAGINDEX_DATABASE_URL_ROI=postgresql://USER:PASSWORD@ep-roi-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or: DATABASE_URL_ROI=...
# Legacy (treated as ROI if ROI-specific vars are unset):
# BAGINDEX_DATABASE_URL=...
# DATABASE_URL=...

# Optional public site origin for share links. Defaults to https://bagrank.xyz
# NEXT_PUBLIC_SITE_URL=https://bagrank.xyz
